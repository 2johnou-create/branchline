# Copy to .env; never commit that file. Configure these on the server, not in the UI.
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BRANCHLINE_ENCRYPTION_KEY=replace-with-generated-fernet-key
# Use the exact deployed public UI origin; comma-separated explicit HTTPS origins only.
BRANCHLINE_ALLOWED_ORIGINS=https://branchline-studio.misty-jelly-1931.chatgpt.site
BRANCHLINE_JOB_TIMEOUT=7200
BRANCHLINE_MAX_ROUNDS=20
BRANCHLINE_MAX_AGENTS=40
# Private Docker networking only; do not publicly expose the upstream engine.
MIROFISH_BASE_URL=http://mirofish:5001
# Use a valid OpenAI-compatible provider API and supported model.
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
ZEP_API_KEY=replace-with-zep-key
# Engine debug logging is suppressed by deploy/engine_entry.py.
FLASK_DEBUG=false

