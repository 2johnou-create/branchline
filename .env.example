# Copy to .env on the Docker host. Never commit real secrets.
# Generate each secret separately with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
BRANCHLINE_MASTER_SECRET=replace-with-generated-random-secret-at-least-32-characters
BRANCHLINE_ENGINE_CLEANUP_SECRET=replace-with-a-different-generated-random-secret-at-least-32-characters

# Same-origin public app + API. Use the actual HTTPS host for production.
# Loopback HTTP is accepted for local development only.
BRANCHLINE_PUBLIC_URL=http://127.0.0.1:8080
BRANCHLINE_ENGINE_ENABLED=false
BRANCHLINE_MAX_ACTIVE_GLOBAL=1
BRANCHLINE_MAX_ROUNDS=10
BRANCHLINE_MAX_AGENTS=20
BRANCHLINE_JOB_TIMEOUT=7200

# Engine credentials. Only the engine receives these in Docker Compose.
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=replace-with-zep-key

# Account verification/recovery. Keep verification enabled in production.
# Configure a verified transactional sender with your chosen email provider.
BRANCHLINE_REQUIRE_EMAIL_VERIFICATION=true
BRANCHLINE_SMTP_HOST=
BRANCHLINE_SMTP_PORT=587
BRANCHLINE_SMTP_USERNAME=
BRANCHLINE_SMTP_PASSWORD=
BRANCHLINE_SMTP_FROM=
BRANCHLINE_SMTP_STARTTLS=true

# Configure Stripe sandbox/test mode first. Checkout stays disabled until
# the operator explicitly enables billing after real engine validation.
BRANCHLINE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_AGENCY=
